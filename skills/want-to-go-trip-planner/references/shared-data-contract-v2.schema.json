          "deliveryDueAt": "2026-08-20T09:00:00Z",
          "scopeConfirmedAt": "2026-08-10T09:00:00Z",
          "customerConfirmedAt": "2026-08-10T10:00:00Z",
          "paymentInstructionsSentAt": "2026-08-10T11:00:00Z",
          "paymentRecordedAt": "2026-08-11T09:00:00Z",
          "deliveryStartedAt": "2026-08-11T10:00:00Z",
          "createdAt": "2026-08-09T00:00:00Z",
          "updatedAt": "2026-08-09T00:00:00Z"
        }
      ],
      "events": [],
      "tombstones": [],
      "ingestBatches": [
        {
          "id": "batch-demo",
          "destination": "曼谷",
          "sourceIds": ["source-shot-commons", "source-link-commons"],
          "createdAt": "2026-08-09T00:00:00Z"
        }
      ]
    }
  ]
}
