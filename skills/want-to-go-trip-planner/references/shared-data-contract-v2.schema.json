            }
          ],
          "changes": [{"placeId": "place-commons", "field": "openingHoursText", "before": "", "after": "每日 08:00–01:00"}]
        }
      ],
      "tripRequests": [
        {
          "id": "request-demo",
          "offerId": "manual-itinerary-beta",
          "destinationKey": "bangkok",
          "status": "completed",
          "startDate": "2026-09-01",
