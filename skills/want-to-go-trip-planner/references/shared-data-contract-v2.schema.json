{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kornvia.com/contracts/want-to-go/2.4.0/schema.json",
  "title": "Kornvia Want-to-Go shared data contract",
  "description": "Version 2.4.0 contract shared by the local Skill and read-only website consumers.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "destinations",
    "places",
    "sources",
    "media",
    "verificationSnapshots",
    "tripRequests",
    "routePlans",
    "events",
    "tombstones"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.4.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "destinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/destination"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "verificationSnapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationSnapshot"
      }
    },
    "tripRequests": {
      "type": "array",
      "description": "Opaque historical records retained in existing private libraries. Never emitted by the public passport."
    },
    "routePlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routePlan"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    },
    "ingestBatches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ingestBatch"
      }
    },
    "bundles": {
      "type": "array",
      "description": "Deprecated raw-ingest compatibility ledger retained for lossless 1.2.3 migration. Website consumers must use sources and media.",
      "deprecated": true,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourcePolicy": {
      "type": "object",
      "required": [
        "version",
        "accessLevel",
        "canSupport",
        "cannotProve",
        "untrustedInstructionsDetected"
      ],
      "properties": {
        "version": {
          "const": "2.3.0"
        },
        "accessLevel": {
          "enum": [
            "submitted",
            "local_only",
            "public_readable",
            "public_blocked",
            "unavailable"
          ]
        },
        "canSupport": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cannotProve": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "untrustedInstructionsDetected": {
          "type": "boolean"
        },
        "untrustedInstructionExcerpts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      },
      "additionalProperties": false
    },
    "platformAccess": {
      "type": "object",
      "description": "Internal platform adapter result. Website customer HTML must not render this object.",
      "required": [
        "mode",
        "status",
        "checkedAt",
        "capabilities",
        "limitations"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "readable",
            "security_check_required",
            "input_incomplete",
            "unavailable"
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "auditSource": {
      "type": "object",
      "required": [
        "url",
        "label",
        "kind"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "official",
            "reliable_public"
          ]
        }
      },
      "additionalProperties": false
    },
    "factAudit": {
      "type": "object",
      "required": [
        "field",
        "status",
        "sources",
        "cannotProve",
        "nextAction"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unverified",
            "verified",
            "conflict",
            "not_found",
            "stale"
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "#/$defs/timestamp"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditSource"
          }
        },
        "cannotProve": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "nextAction": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "executionRisk": {
      "type": "object",
      "required": [
        "type",
        "scope",
        "status",
        "summary",
        "sources",
        "cannotProve",
        "nextAction"
      ],
      "properties": {
        "type": {
          "enum": [
            "last_mile",
            "reservation_ticket",
            "weather_sensitive",
            "temporary_closure",
            "transfer_buffer"
          ]
        },
        "scope": {
          "enum": [
            "place",
            "route",
            "trip"
          ]
        },
        "status": {
          "enum": [
            "unverified",
            "verified",
            "conflict",
            "not_found",
            "stale"
          ]
        },
        "summary": {
          "type": "string"
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "validUntil": {
          "$ref": "#/$defs/timestamp"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditSource"
          }
        },
        "cannotProve": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "nextAction": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "adjust",
            "info"
          ]
        }
      },
      "additionalProperties": false
    },
    "verificationItem": {
      "type": "object",
      "required": [
        "placeId",
        "accessLevel",
        "canSupport",
        "cannotProve",
        "facts",
        "factAudits",
        "executionRisks"
      ],
      "properties": {
        "placeId": {
          "type": "string",
          "minLength": 1
        },
        "accessLevel": {
          "enum": [
            "submitted",
            "local_only",
            "public_readable",
            "public_blocked",
            "unavailable"
          ]
        },
        "canSupport": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cannotProve": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "facts": {
          "type": "object"
        },
        "factAudits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factAudit"
          }
        },
        "executionRisks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionRisk"
          }
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": [
        "id",
        "key",
        "name",
        "status",
        "placeIds",
        "sourceIds",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "needs_confirmation",
            "archived"
          ]
        },
        "placeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "placeCount": {
          "type": "integer",
          "minimum": 0
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "passportGeneratedAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "required": [
        "id",
        "destinationKey",
        "destinationStatus",
        "name",
        "placeType",
        "sourceIds",
        "mediaIds",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "destinationKey": {
          "type": "string",
          "minLength": 1
        },
        "destinationStatus": {
          "enum": [
            "confirmed",
            "needs_confirmation"
          ]
        },
        "name": {
          "type": "string"
        },
        "verifiedName": {
          "type": "string"
        },
        "localName": {
          "type": "string"
        },
        "placeType": {
          "enum": [
            "business",
            "venue",
            "public_space",
            "route"
          ]
        },
        "branch": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "positionText": {
          "type": "string"
        },
        "openingHoursText": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "visitTip": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "mediaIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        },
        "identityKey": {
          "type": "string"
        },
        "nameSource": {
          "enum": [
            "user_named",
            "public_page",
            "material_ocr",
            "visual_review",
            "unresolved"
          ]
        },
        "nameRequiresConfirmation": {
          "type": "boolean"
        },
        "routeStart": {
          "type": "string"
        },
        "routeEnd": {
          "type": "string"
        },
        "waypoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedDuration": {
          "type": "string"
        },
        "displayMediaId": {
          "type": "string"
        },
        "detailLookupAudit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factAudit"
          }
        },
        "executionRisks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionRisk"
          }
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "openingHours": {
          "$ref": "#/$defs/openingHoursValue"
        },
        "mapRegion": {
          "enum": [
            "mainland",
            "outside_mainland",
            "unknown"
          ]
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "ledgerVersion",
        "batchId",
        "group",
        "type",
        "status",
        "destinationKey",
        "submittedAt",
        "sourcePolicy",
        "mediaIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ledgerVersion": {
          "type": "integer",
          "minimum": 1
        },
        "batchId": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "screenshot",
            "link",
            "video",
            "text",
            "saved_html"
          ]
        },
        "status": {
          "enum": [
            "captured",
            "failed",
            "superseded"
          ]
        },
        "destinationKey": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string"
        },
        "submittedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "submittedUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "platform": {
          "enum": [
            "generic_web",
            "xiaohongshu",
            "ctrip",
            "wechat_official",
            "mafengwo",
            "douyin",
            "tiktok",
            "instagram",
            "youtube"
          ]
        },
        "platformItemId": {
          "type": "string"
        },
        "platformAccess": {
          "$ref": "#/$defs/platformAccess"
        },
        "sourcePolicy": {
          "$ref": "#/$defs/sourcePolicy"
        },
        "mediaIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "object"
        },
        "failureReason": {
          "type": "string"
        },
        "failureCode": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "submittedUrl"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": [
        "id",
        "sourceId",
        "kind",
        "role",
        "path",
        "sha256",
        "immutableOriginal",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "role": {
          "enum": [
            "original",
            "display_crop",
            "evidence_frame"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "immutableOriginal": {
          "type": "boolean"
        },
        "mimeType": {
          "type": "string"
        },
        "derivedFromMediaId": {
          "type": "string"
        },
        "displayPhotoScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "displayPhotoEligible": {
          "type": "boolean"
        },
        "crop": {
          "type": "object"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "routeStop": {
      "type": "object",
      "required": [
        "placeId",
        "timeBlock"
      ],
      "properties": {
        "placeId": {
          "type": "string",
          "minLength": 1
        },
        "timeBlock": {
          "enum": [
            "morning",
            "midday",
            "afternoon",
            "evening",
            "flexible"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "major": {
          "type": "boolean"
        },
        "reservationRequired": {
          "type": "boolean"
        },
        "reservationStatus": {
          "enum": [
            "unknown",
            "pending",
            "confirmed",
            "unavailable",
            "not_required"
          ]
        },
        "timing": {
          "$ref": "#/$defs/routeTiming"
        }
      },
      "additionalProperties": false
    },
    "routeConnection": {
      "type": "object",
      "required": [
        "mode",
        "status"
      ],
      "properties": {
        "fromPlaceId": {
          "type": "string",
          "minLength": 1
        },
        "toPlaceId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "walk",
            "transit",
            "rail",
            "boat",
            "taxi",
            "drive",
            "flight",
            "flexible"
          ]
        },
        "durationText": {
          "type": "string",
          "maxLength": 160
        },
        "status": {
          "enum": [
            "unverified",
            "verified",
            "conflict",
            "not_found",
            "stale"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "intercity": {
          "type": "boolean"
        },
        "fromLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "toLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "distanceMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000000
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "validUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "intercity": {
                "const": true
              }
            },
            "required": [
              "intercity"
            ]
          },
          "then": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "fromPlaceId"
                    ]
                  },
                  {
                    "required": [
                      "fromLabel"
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "toPlaceId"
                    ]
                  },
                  {
                    "required": [
                      "toLabel"
                    ]
                  }
                ]
              }
            ]
          },
          "else": {
            "required": [
              "fromPlaceId",
              "toPlaceId"
            ]
          }
        }
      ]
    },
    "routeDay": {
      "type": "object",
      "required": [
        "day",
        "title",
        "stops",
        "connections"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeStop"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeConnection"
          }
        },
        "lunch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "rest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "backup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "dropIfDelayed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "onsiteWalkingMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        }
      },
      "additionalProperties": false
    },
    "routeTripProfile": {
      "type": "object",
      "required": [
        "days"
      ],
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "partySize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "mobilityNotes": {
          "type": "string",
          "maxLength": 500
        },
        "walkingLimit": {
          "type": "string",
          "maxLength": 160
        },
        "mustGoPlaceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dietaryRestrictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hotelArea": {
          "type": "string",
          "maxLength": 160
        },
        "pace": {
          "type": "string",
          "maxLength": 120
        },
        "reducedMobility": {
          "type": "boolean"
        },
        "walkingLimitMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        },
        "maxMajorStops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxTransferMinutes": {
          "type": "integer",
